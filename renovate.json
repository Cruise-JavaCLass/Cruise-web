{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":rebaseStalePrs"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "schedule": [
    "before 8am on monday"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group React dependencies",
      "matchPackagePatterns": [
        "^react",
        "^@types/react"
      ],
      "groupName": "react-monorepo"
    },
    {
      "description": "Group Vitest and testing library dependencies",
      "matchPackagePatterns": [
        "^@vitest",
        "^vitest",
        "^@testing-library"
      ],
      "groupName": "testing-framework"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Separate major updates requiring manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "breaking-change"
      ],
      "commitMessagePrefix": "chore(deps-breaking):"
    }
  ]
}
