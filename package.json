{
  "name": "cruise-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && npm run test:jules",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:jules",
    "test:ui": "vitest --ui",
    "test:run": "vitest run && npm run test:jules",
    "test:ci": "vitest run --coverage --reporter=verbose && npm run test:jules",
    "test:jules": "node --test .github/scripts/jules-client.test.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.55.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/animejs": "^3.1.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
